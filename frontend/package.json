{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "dev": "env-cmd -f ../.env.development next dev -p $FRONTEND_PORT",
        "dev:local": "env-cmd -f ../.env.development next dev --webpack -p 9260",
        "dev:docker": "next dev --webpack -H 0.0.0.0 -p $PORT",
        "start": "env-cmd -f ../.env.production next start -p $FRONTEND_PORT",
        "build": "next build",
        "lint": "eslint"
    },
    "dependencies": {
        "@mui/icons-material": "^9.0.1",
        "@mui/material": "^9.0.1",
        "@mui/x-date-pickers": "^9.2.0",
        "@reduxjs/toolkit": "^2.12.0",
        "antd": "^6.4.3",
        "axios": "^1.16.1",
        "country-flag-icons": "^1.6.17",
        "date-fns": "^4.2.1",
        "env-cmd": "^11.0.0",
        "js-cookie": "^3.0.7",
        "lucide-react": "^1.16.0",
        "material-react-table": "^3.2.1",
        "next": "16.2.6",
        "nextjs-toploader": "^3.9.17",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-markdown": "^10.1.0",
        "react-redux": "^9.3.0",
        "redux-persist": "^6.0.0",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@tailwindcss/typography": "^0.5.19",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "cross-env": "^10.1.0",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}