{
    "name": "affiliate-product-catalog",
    "version": "1.0.0",
    "description": "Affiliate Product Catalog (APC)",
    "keywords": [
        "apc",
        "affiliate-product-catalog",
        "nguyentrunglong"
    ],
    "homepage": "https://github.com/LoDtus/affiliate-product-catalog#readme",
    "bugs": {
        "url": "https://github.com/LoDtus/affiliate-product-catalog/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LoDtus/affiliate-product-catalog.git"
    },
    "license": "ISC",
    "author": "nguyentrunglong",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "install:data": "npm --prefix data install",
        "install:backend": "npm --prefix backend install",
        "install:frontend": "npm --prefix frontend install",
        "install:admin": "npm --prefix admin install",
        "install:all": "npm run install:admin && npm run install:data && npm run install:backend && npm run install:frontend",

        "data:init": "npm --prefix data run db:init",
        "data:seed": "npm --prefix data run db:seed",

        "backend:dev": "npm run start:dev --prefix backend",
        "backend:prod": "npm run start:dev --prefix backend",

        "frontend:dev": "npm run dev --prefix frontend",
        "frontend:prod": "npm run dev --prefix frontend",

        "admin:dev": "npm run dev --prefix admin",
        "admin:prod": "npm run dev --prefix admin",

        "docker:dev-up": "docker compose --profile dev up -d && npm run db:seed",
        "docker:dev-down": "docker compose --profile dev down -v",

        "docker:prod-up": "docker compose --profile prod up -d && npm run db:init",
        "docker:prod-down": "docker compose --profile prod down"
    }
}